rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsData(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create, read, update, delete:
        if ownsData(userId);

      match /playlists/{playlistId} {
        allow read, write:
          if ownsData(userId);
      }
    }
  }
}